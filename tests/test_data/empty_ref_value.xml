<?xml-model href="http://www.stoa.org/epidoc/schema/latest/tei-epidoc.rng" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Dummy XML with a cited element whose @n is empty</title>
            </titleStmt>
            <publicationStmt>
                <p>Unpublished</p>
            </publicationStmt>
            <sourceDesc>
                <p>Generated example.</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <refsDecl>
                <citeStructure use="@n" match="/TEI/text/body/div" unit="chapter">
                    <citeStructure use="@n" match=".//milestone[@unit='section']" unit="section" delim="."/>
                </citeStructure>
            </refsDecl>
        </encodingDesc>
    </teiHeader>
    <!-- A comment: neither this nor the processing instruction above is an element,
         and neither must trip the citeStructure checks up. -->
    <text>
        <body>
            <div n="1">
                <p><milestone unit="section" n="1"/>Some text.</p>
            </div>
            <div n="">
                <p><milestone unit="section" n="1"/>A chapter whose @n was lost in conversion.</p>
            </div>
            <div>
                <p><milestone unit="section" n=""/>A chapter with no @n at all.</p>
            </div>
        </body>
    </text>
</TEI>
