<?xml-model href="http://www.stoa.org/epidoc/schema/latest/tei-epidoc.rng" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Dummy XML with a duplicated page in a milestone (pb/lb) Citation Structure</title>
            </titleStmt>
            <publicationStmt>
                <p>Unpublished</p>
            </publicationStmt>
            <sourceDesc>
                <p>Generated example.</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <refsDecl>
                <citeStructure use="@n" match="/TEI/text/body//pb" unit="page">
                    <citeStructure use="@n" match=".//lb" unit="line" delim="."/>
                </citeStructure>
            </refsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <p>
                <pb n="1"/>
                <lb n="1"/>First line of page 1.
                <lb n="2"/>Second line of page 1.
                <pb n="2"/>
                <lb n="1"/>First line of page 2.
                <lb n="2"/>Second line of page 2.
                <pb n="2"/>
                <lb n="1"/>First line of the duplicated page 2.
                <lb n="2"/>Second line of the duplicated page 2.
            </p>
        </body>
    </text>
</TEI>
